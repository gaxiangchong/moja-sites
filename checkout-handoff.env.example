# Option B: catalog + checkout handoff (member-app Nest API)
# Local: match PORT in moja-member-app .env (default 3000) — NOT the member web UI (5193).
MEMBER_API_BASE_URL=http://127.0.0.1:3000

# Production mojamaison.com — required for live catalog:
# MEMBER_API_BASE_URL=https://your-production-member-api.example.com
# MEMBER_API_TIMEOUT_MS=5000

# Force JSON-only mode (emergency fallback; edit config/products.catalog.json):
# CATALOG_SOURCE=local

# Optional: public member app URL (redirect URL comes from member API)
# MEMBER_APP_PUBLIC_URL=http://localhost:5193
