# Option B: catalog + checkout handoff (member-app Nest API)

# Production (mojamaison.com storefront):
MEMBER_API_BASE_URL=https://api.mojamaison.com
MEMBER_API_TIMEOUT_MS=2500
CATALOG_CACHE_SECONDS=300
NEXT_PUBLIC_MEMBER_ASSET_BASE=https://api.mojamaison.com
NEXT_PUBLIC_MEMBER_APP_URL=https://app.mojamaison.com

# Local Nest API — match PORT in moja-member-app .env (NOT the member web UI on 5193):
# MEMBER_API_BASE_URL=http://127.0.0.1:3153

# Force JSON-only mode (emergency fallback; edit config/products.catalog.json):
# CATALOG_SOURCE=local
