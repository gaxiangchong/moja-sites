# Copy to .env.local for local dev. Values must match the member API handoff settings.

# If `npx prisma generate` fails with "unable to get local issuer certificate", your network
# is intercepting HTTPS; point Node at your org root CA PEM, e.g.:
#   set NODE_EXTRA_CA_CERTS=C:\path\to\corp-root-ca.pem
# (PowerShell: $env:NODE_EXTRA_CA_CERTS="C:\path\to\corp-root-ca.pem")

# SQLite replay store (recommended). Without DATABASE_URL, replay uses in-memory storage (dev only).
DATABASE_URL="file:./prisma/shop-sso.db"

# Same secret the member API uses to sign handoff tokens (or explicit SHOP_HANDOFF_JWT_SECRET there).
SHOP_HANDOFF_JWT_SECRET="same-as-member-JWT_SECRET-or-SHOP_HANDOFF_JWT_SECRET"

# Public base URL of the member API (issuer claim)
SHOP_HANDOFF_ISSUER="http://localhost:3153"

# Audience claim (default shop)
SHOP_HANDOFF_AUDIENCE=shop

# Where to send the browser after a successful consume
SHOP_AFTER_SSO_PATH=/shop

# Failed consume (replay, bad token, etc.)
SHOP_AFTER_SSO_FAIL_PATH=/shop

# Optional cookie name for the shop session hint (HttpOnly; shop still treats user as anonymous until you wire auth UI)
# SHOP_MEMBER_SESSION_COOKIE=moja_member_customer_id
