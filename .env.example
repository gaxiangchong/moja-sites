# Copy to `.env.local` for local development (see docker-compose.yml).
# DATABASE_URL matches docker compose postgres service (host port 55432).
DATABASE_URL="postgresql://moja:moja_dev@localhost:55432/moja_sites"

# SSO handoff from moja-member-app (see docs/architecture.md)
# SHOP_HANDOFF_JWT_SECRET=
# SHOP_HANDOFF_ISSUER=
# SHOP_HANDOFF_AUDIENCE=shop

# --- Xendit (hosted Payment Session checkout) -------------------------------
# Secret key from Xendit Dashboard (starts with xnd_…)
# XENDIT_SECRET_KEY=
# Webhook verification token (header x-callback-token). Required in production.
# XENDIT_WEBHOOK_TOKEN=
# Public base URL for success/cancel redirects (use your real domain on Render).
# XENDIT_PUBLIC_BASE_URL=https://www.example.com
# Register webhook URL: {XENDIT_PUBLIC_BASE_URL}/api/webhooks/xendit
# Register SalesPlay webhooks (customers.update + receipts.update): {XENDIT_PUBLIC_BASE_URL}/api/webhooks/salesplay

# --- SalesPlay (loyalty / POS sync) -----------------------------------------
# Personal access token from SalesPlay Backoffice → Integrations → Access Token
# SALESPLAY_ACCESS_TOKEN=
# Shop id from GET https://api.salesplaypos.com/v1.0/shops (required for online_orders)
# SALESPLAY_SHOP_ID=
# Fallback product_code when order lines have no salesplayProductId (required unless every line is mapped)
# SALESPLAY_FALLBACK_PRODUCT_CODE=
# Optional overrides (see docs/payments-runbook.md)
# SALESPLAY_API_BASE_URL=https://api.salesplaypos.com/v1.0
# SALESPLAY_ORDER_TYPE=Delivery
# SALESPLAY_ORDER_PAYMENT_TYPE=Card
# SALESPLAY_TARGET_TERMINAL=
# SALESPLAY_CHANNEL_ORDER_STATUS_ID=0
# SALESPLAY_CHANNEL_ORDER_STATUS_NAME=pending

# --- SalesPlay inbound webhooks (loyalty cache) -----------------------------
# Shared secret checked against x-salesplay-webhook-secret, x-webhook-secret,
# or Authorization: Bearer (same value). Required in production.
# SALESPLAY_WEBHOOK_SECRET=
# Optional: reject payloads whose merchant_id does not match (from webhook JSON).
# SALESPLAY_MERCHANT_ID=

# --- Cron (SalesPlay outbox processor) ------------------------------------
# Render Cron / external scheduler: GET or POST /api/cron/process-outbox?limit=10
# Authorization: Bearer <CRON_SECRET>   OR   header x-cron-secret: <CRON_SECRET>
# In production, CRON_SECRET must be set or the endpoint returns 401.
# CRON_SECRET=
