# Copy to `.env.local` for local development (see docker-compose.yml).
# DATABASE_URL matches docker compose postgres service (host port 55432).
DATABASE_URL="postgresql://moja:moja_dev@localhost:55432/moja_sites"

# SSO handoff from moja-member-app (see docs/architecture.md)
# SHOP_HANDOFF_JWT_SECRET=
# SHOP_HANDOFF_ISSUER=
# SHOP_HANDOFF_AUDIENCE=shop

# --- Xendit (hosted Payment Session checkout) -------------------------------
# Secret key from Xendit Dashboard (starts with xnd_…)
# XENDIT_SECRET_KEY=
# Webhook verification token (header x-callback-token). Required in production.
# XENDIT_WEBHOOK_TOKEN=
# Public base URL for success/cancel redirects (use your real domain on Render).
# XENDIT_PUBLIC_BASE_URL=https://www.example.com
# Register webhook URL: {XENDIT_PUBLIC_BASE_URL}/api/webhooks/xendit
